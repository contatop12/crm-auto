# Copie para .env e preencha. NUNCA commite o .env.
#
# Em produção nada disto vive em arquivo: use `wrangler secret put NOME`.
# O .dev.vars (tambem gitignored) e o equivalente local do wrangler dev.

# -----------------------------------------------------------------------------
# Chatwoot (fork fazer.ai) — credencial GLOBAL, atende todas as contas
# -----------------------------------------------------------------------------
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=

# -----------------------------------------------------------------------------
# Google Ads (Data Manager API + GAQL)
# -----------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MCC_ID=

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp) — etiquetas e alerta de erro
# -----------------------------------------------------------------------------
EVOLUTION_SERVER_URL=
EVOLUTION_API_KEY=
EVOLUTION_ALERT_INSTANCE=
EVOLUTION_ALERT_GROUP_ID=

# -----------------------------------------------------------------------------
# Cloudflare Access (Zero Trust) — auth do painel
# -----------------------------------------------------------------------------
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# -----------------------------------------------------------------------------
# Google Sheets (espelho best-effort; falha aqui nunca falha o pipeline)
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
